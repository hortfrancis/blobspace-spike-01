{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blobspace-spike-01",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  // The built client. A request that matches a file is served from here; the
  // rest, /ws included, reaches the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // One Room per Discord Activity instance, looked up by instanceId.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": {
    "enabled": true
  }
}
